{
  "name": "pauseless",
  "version": "0.3.0",
  "description": "Cut silences and filler sounds out of videos in the browser and export to Final Cut Pro, DaVinci Resolve, Premiere Pro or CapCut.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:single": "tsc && vite build --mode single",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "silence-removal",
    "video-editing",
    "webcodecs",
    "fcpxml",
    "premiere",
    "davinci-resolve",
    "capcut",
    "podcast"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "dependencies": {
    "mp4-muxer": "^5.2.1"
  },
  "private": true
}
